{
  "name": "cchess",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:e2e": "$HOME/.maestro/bin/maestro test .maestro --exclude-tags=needs-live-server",
    "opponent": "node scripts/opponent.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@types/react": "~19.3.0",
    "axios": "1.20.0",
    "chess.js": "1.4.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-font": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "test-renderer": "1.3.0"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md}": "prettier --write --ignore-unknown"
  }
}
