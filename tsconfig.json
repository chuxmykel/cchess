{
  "compilerOptions": {
    "strict": false,
    "types": ["jest", "node"],
    // react-native-view-shot's "react-native" export condition, which Expo's
    // base config resolves, is its .tsx source - type-checked as ours, and
    // failing to. Its built declarations instead.
    "paths": {
      "react-native-view-shot": [
        "./node_modules/react-native-view-shot/lib/index.d.ts"
      ]
    }
  },
  "extends": "expo/tsconfig.base"
}
